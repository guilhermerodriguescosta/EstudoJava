    {
      "name": "02 - Histórico - CRUD e duplicidade",
      "item": [
        {
          "name": "Criar cálculo no histórico - 201 Created",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "usuario",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "123",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/historico?numero1={{calculoNumero1}}&numero2={{calculoNumero2}}&operacao=DIVISAO"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('calculoId');",
                  "pm.collectionVariables.unset('calculoSnapshot');",
                  "pm.collectionVariables.set('calculoNumero1', 10000 + Math.floor(Math.random() * 890000));",
                  "pm.collectionVariables.set('calculoNumero2', 10000 + Math.floor(Math.random() * 890000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    const a = Number(pm.collectionVariables.get('calculoNumero1'));",
                  "    const b = Number(pm.collectionVariables.get('calculoNumero2'));",
                  "    pm.test('ID gerado pelo banco', () => pm.expect(body.id).to.be.a('number').and.above(0));",
                  "    pm.test('Valores e operação corretos', () => {",
                  "        pm.expect(body.numero1).to.eql(a);",
                  "        pm.expect(body.numero2).to.eql(b);",
                  "        pm.expect(body.operacao).to.eql('DIVISAO');",
                  "        pm.expect(body.resultado).to.be.closeTo(a / b, 1e-9);",
                  "    });",
                  "    pm.test(\"Location corresponde ao ID\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/historico/\" + body.id));",
                  "    pm.collectionVariables.set('calculoId', String(body.id));",
                  "    pm.collectionVariables.set('calculoSnapshot', JSON.stringify(body));",
                  "}"
                ]
              }
            }
          ]
        },
