              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Erro informa cálculo duplicado', () => pm.expect(pm.response.json().erro).to.eql('Cálculo duplicado'));"
                ]
              }
            }
          ]
