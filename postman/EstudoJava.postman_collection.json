    {
      "name": "04 - Pedidos - RabbitMQ e PostgreSQL",
      "item": [
        {
          "name": "Enviar pedido - 202 Accepted",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/pedidos?descricao={{pedidoDescricao}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('pedidoId');",
                  "pm.collectionVariables.unset('pedidoSnapshot');",
                  "pm.collectionVariables.set('pedidoDescricao', 'Postman-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Confirmação, fila e status corretos', () => {",
                  "        pm.expect(body.mensagem).to.eql('Pedido recebido e enviado para processamento.');",
                  "        pm.expect(body.fila).to.eql('pedidos');",
                  "        pm.expect(body.status).to.eql('PENDING');",
                  "        pm.expect(body.descricao).to.eql(pm.collectionVariables.get('pedidoDescricao'));",
                  "        pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    });",
                  "    pm.collectionVariables.set('pedidoId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Aguardar pedido processado - 200 OK",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos/{{pedidoId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('pedidoId')) throw new Error('Execute primeiro a preparação desta pasta: falta pedidoId.');",
                  "if (!pm.collectionVariables.get('pedidoDescricao')) throw new Error('Execute primeiro a preparação desta pasta: falta pedidoDescricao.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.collectionVariables.get('pedidoId');",
                  "const descricao = pm.collectionVariables.get('pedidoDescricao');",
                  "const url = pm.variables.replaceIn('{{baseUrl}}') + '/pedidos/' + id;",
                  "function conferir(response, attempt) {",
                  "    if (response.code !== 200) {",
                  "        pm.test('Pedido existe no banco', () => pm.expect(response.code).to.eql(200));",
                  "        return;",
                  "    }",
                  "    const body = response.json();",
                  "    if (body.status === 'PENDING' && attempt < 20) {",
                  "        setTimeout(() => pm.sendRequest(url, (error, next) => {",
                  "            if (error) { pm.test('Consulta do pedido sem erro de conexão', () => pm.expect(error).to.eql(null)); return; }",
                  "            conferir(next, attempt + 1);",
                  "        }), 500);",
                  "        return;",
                  "    }",
                  "    pm.test('Pedido processado pelo consumidor RabbitMQ', () => {",
                  "        pm.expect(body.id).to.eql(id);",
                  "        pm.expect(body.descricao).to.eql(descricao);",
                  "        pm.expect(body.status).to.eql('PROCESSED');",
                  "    });",
                  "    if (body.status === 'PROCESSED') pm.collectionVariables.set('pedidoSnapshot', JSON.stringify(body));",
                  "}",
                  "conferir(pm.response, 0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar UUID não cadastrado - 404",
