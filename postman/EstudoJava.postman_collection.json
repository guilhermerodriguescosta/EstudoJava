                  "for (let i = 1; i <= 3; i++) pm.collectionVariables.unset('limiteId' + i);",
                  "const base = 10000 + Math.floor(Math.random() * 889990);",
                  "for (let i = 1; i <= 4; i++) pm.collectionVariables.set('limiteNumero' + i, base + i);",
                  "pm.collectionVariables.set('limiteNumero2Base', 10000 + Math.floor(Math.random() * 890000));",
                  "const ultimo = Number(pm.collectionVariables.get('limiteUltimaTentativa') || 0);",
                  "const espera = ultimo ? Math.max(0, 61000 - (Date.now() - ultimo)) : 61000;",
                  "if (espera > 0) { console.info('Aguardando janela do limite: ' + espera + ' ms'); setTimeout(() => {}, espera); }"
